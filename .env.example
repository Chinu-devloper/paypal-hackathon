# Copy this file to .env and fill in the values you want. Every variable is optional:
# anything left blank falls back to a built-in simulator, so the app always runs.

# --- PayPal (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Both are required together. Without them, PayPal calls return simulated v2-shaped responses.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- AI (OpenAI-compatible) ---
# Defaults to Google Gemini. Without a key, the deterministic demo engine is used.
# Gemini (free): https://aistudio.google.com/apikey
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-flash-lite-latest
# Groq alternative:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- Channel3 product search ---
# Without a key, a curated fallback catalog is used.
CHANNEL3_API_KEY=

# --- App ---
# DATABASE_PATH=./data/milestoneos.db
# ENABLE_DEMO_TOOLS=false        # production: hides demo mode and blocks demo-only endpoints
# NEXT_PUBLIC_DEFAULT_MODE=user  # which mode the UI opens in (demo | user)
# SIM_LATENCY_MS=180             # simulated PayPal latency; lower it for a snappier demo
